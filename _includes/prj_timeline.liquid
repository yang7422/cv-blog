{%- comment -%}
  Session timeline for a project page: one mark per session, one column per week.
  Wide screens get an annotated SVG; below 768px a full-width strip and a short list
  take its place (styles: "Project pages" in _sass/_custom.scss).

  Parameters
    sessions  array of sessions in date order (from _data/ihlab_seminars.yml: date, topic,
              and optionally part, milestone, anchor, approx)
    start     Monday of week 0, 'YYYY-MM-DD'
    weeks     number of week columns; the columns always fill the full width
    ticks     axis labels 'YYYY-MM-DD|Label,YYYY-MM-DD|Label' (optional)
    parts     brackets under the axis 'key|Name,key|Name', matched against session.part (optional)
    noun      what one mark is, plural (default 'sessions')
    id        element id (default 'prj-timeline'); one timeline per page

  Example
    {% include prj_timeline.liquid sessions=sessions start='2019-12-16' weeks=14
       ticks='2020-01-06|Jan 2020,2020-03-02|Mar 2020' parts='arm|Robot arm,leg|Legged robot' %}
{%- endcomment -%}
{%- assign tl_id = include.id | default: 'prj-timeline' -%}
{%- assign tl_noun = include.noun | default: 'sessions' -%}
{%- assign tl_s = include.sessions -%}
{%- assign t0 = include.start | date: '%s' | plus: 0 -%}
{%- assign nweeks = include.weeks | plus: 0 -%}
{%- assign pitch = 830.0 | divided_by: nweeks -%}
{%- assign inset = pitch | minus: 8 | divided_by: 2.0 -%}
{%- assign tl_parts = include.parts | default: '' | split: ',' -%}
{%- if tl_parts.size > 0 -%}{%- assign tl_h = 128 -%}{%- else -%}{%- assign tl_h = 88 -%}{%- endif -%}
{%- capture tl_cells -%}
{%- for w in (1..nweeks) -%}
{%- assign x = w | minus: 1 | times: pitch | plus: 10 | plus: inset | round: 2 -%}
<rect class="prj-empty" x="{{ x }}" y="56" width="8" height="8" rx="2"/>
{%- endfor -%}
{%- assign prev = -1 -%}
{%- assign stack = 0 -%}
{%- for s in tl_s -%}
{%- assign ts = s.date | date: '%s' | plus: 0 -%}
{%- assign wk = ts | minus: t0 | divided_by: 604800 -%}
{%- if wk == prev -%}{%- assign stack = stack | plus: 1 -%}{%- else -%}{%- assign stack = 0 -%}{%- endif -%}
{%- assign prev = wk -%}
{%- assign x = wk | times: pitch | plus: 10 | plus: inset | round: 2 -%}
{%- assign y = stack | times: 10 -%}
{%- assign y = 56 | minus: y -%}
<rect class="prj-cell" x="{{ x }}" y="{{ y }}" width="8" height="8" rx="2" data-date="{% if s.approx %}about {% endif %}{{ s.date | date: '%b %-d, %Y' }}" data-topic="{{ s.topic | escape }}"/>
{%- endfor -%}
{%- endcapture -%}
{%- assign first = tl_s.first.date | date: '%B %Y' -%}
{%- assign last = tl_s.last.date | date: '%B %Y' -%}
<div class="prj-timeline" id="{{ tl_id }}">
  <svg class="prj-tl-wide" viewBox="0 0 850 {{ tl_h }}" role="img" tabindex="0" aria-labelledby="{{ tl_id }}-title {{ tl_id }}-desc">
    <title id="{{ tl_id }}-title">Timeline</title>
    <desc id="{{ tl_id }}-desc">{{ tl_s.size }} {{ tl_noun }} from {{ first }} to {{ last }}: one square per session, one column per week. Arrow keys step through them; the log below lists every topic.</desc>
    {{ tl_cells }}
    {%- assign prev = -1 -%}
    {%- assign stack = 0 -%}
    {%- for s in tl_s -%}
    {%- assign ts = s.date | date: '%s' | plus: 0 -%}
    {%- assign wk = ts | minus: t0 | divided_by: 604800 -%}
    {%- if wk == prev -%}{%- assign stack = stack | plus: 1 -%}{%- else -%}{%- assign stack = 0 -%}{%- endif -%}
    {%- assign prev = wk -%}
    {%- if s.milestone -%}
    {%- assign cx = wk | times: pitch | plus: 14 | plus: inset | round: 2 -%}
    {%- assign ly = stack | times: 10 -%}
    {%- assign ly = 53 | minus: ly -%}
    {%- comment -%} Labels near either edge grow inward unless the data sets an anchor. {%- endcomment -%}
    {%- if s.anchor -%}{%- assign ma = s.anchor -%}{%- elsif cx < 130 -%}{%- assign ma = 'start' -%}{%- elsif cx > 720 -%}{%- assign ma = 'end' -%}{%- else -%}{%- assign ma = 'middle' -%}{%- endif -%}
    <line class="prj-rule" x1="{{ cx }}" y1="17" x2="{{ cx }}" y2="{{ ly }}"/>
    <text class="prj-text" x="{{ cx }}" y="12" text-anchor="{{ ma }}">{{ s.milestone }}</text>
    {%- endif -%}
    {%- endfor -%}
    {%- assign tl_ticks = include.ticks | default: '' | split: ',' -%}
    {%- for m in tl_ticks -%}
    {%- assign mp = m | split: '|' -%}
    {%- assign ts = mp[0] | date: '%s' | plus: 0 -%}
    {%- assign mx = ts | minus: t0 | divided_by: 604800 | times: pitch | plus: 14 | plus: inset | round: 2 -%}
    <line class="prj-rule" x1="{{ mx }}" y1="67" x2="{{ mx }}" y2="71"/>
    <text class="prj-text-muted" x="{{ mx }}" y="81" text-anchor="middle">{{ mp[1] }}</text>
    {%- endfor -%}
    {%- assign last_i = tl_parts.size | minus: 1 -%}
    {%- for pd in tl_parts -%}
    {%- assign pk = pd | split: '|' -%}
    {%- assign ps = tl_s | where: 'part', pk[0] -%}
    {%- if ps.size > 0 -%}
    {%- assign a = ps.first.date | date: '%s' | plus: 0 -%}
    {%- assign a = a | minus: t0 | divided_by: 604800 | times: pitch | plus: 10 | plus: inset | round: 2 -%}
    {%- assign b = ps.last.date | date: '%s' | plus: 0 -%}
    {%- assign b = b | minus: t0 | divided_by: 604800 | times: pitch | plus: 18 | plus: inset | round: 2 -%}
    {%- if tl_parts.size == 1 or forloop.first -%}{%- assign anchor = 'start' -%}{%- assign tx = a -%}{%- elsif forloop.index0 == last_i -%}{%- assign anchor = 'end' -%}{%- assign tx = b -%}{%- else -%}{%- assign anchor = 'middle' -%}{%- assign tx = a | plus: b | divided_by: 2.0 | round: 2 -%}{%- endif -%}
    <path class="prj-rule" d="M{{ a }} 90 V94 H{{ b }} V90"/>
    <text class="prj-text" x="{{ tx }}" y="108" text-anchor="{{ anchor }}">{{ pk[1] }}</text>
    <text class="prj-text-muted" x="{{ tx }}" y="121" text-anchor="{{ anchor }}">{{ ps.first.date | date: '%b %Y' }} – {{ ps.last.date | date: '%b %Y' }} · {{ ps.size }} {{ tl_noun }}</text>
    {%- endif -%}
    {%- endfor -%}
  </svg>
  <svg class="prj-tl-narrow" viewBox="0 34 850 32" preserveAspectRatio="none" role="img" tabindex="0" aria-labelledby="{{ tl_id }}-ntitle">
    <title id="{{ tl_id }}-ntitle">Timeline: {{ tl_s.size }} {{ tl_noun }}, one bar per week from {{ first }} to {{ last }}</title>
    {{ tl_cells }}
  </svg>
  <ol class="prj-tl-legend">
    {%- if tl_parts.size > 0 -%}
      {%- for pd in tl_parts -%}
        {%- assign pk = pd | split: '|' -%}
        {%- assign ps = tl_s | where: 'part', pk[0] -%}
        <li>
          <strong>{{ pk[1] }}</strong> <span class="nobr">{{ ps.first.date | date: '%b %Y' }} – {{ ps.last.date | date: '%b %Y' }}</span> ·
          <span class="nobr">
            {{- ps.size }}
            {{ tl_noun -}}
          </span>
          {%- for s in ps -%}
            {%- if s.milestone -%}
              &nbsp;· {{ s.milestone }}
              <span class="nobr">({{ s.date | date: '%b %Y' }})</span>
            {%- endif -%}
          {%- endfor -%}
        </li>
      {%- endfor -%}
    {%- else -%}
      <li>
        <span class="nobr">{{ tl_s.first.date | date: '%b %Y' }} – {{ tl_s.last.date | date: '%b %Y' }}</span> ·
        <span class="nobr">
          {{- tl_s.size }}
          {{ tl_noun -}}
        </span>
        {%- for s in tl_s -%}
          {%- if s.milestone -%}
            &nbsp;· {{ s.milestone }}
            <span class="nobr">({{ s.date | date: '%b %Y' }})</span>
          {%- endif -%}
        {%- endfor -%}
      </li>
    {%- endif -%}
  </ol>
</div>
<script>
  // Timeline tooltip: the nearest square within 24px on hover or tap; arrow keys when a chart has focus.
  (function () {
    var root = document.getElementById('{{ tl_id }}');
    if (!root) return;
    var tip = document.createElement('div');
    var tipDate = document.createElement('div');
    var tipText = document.createElement('div');
    tip.className = 'prj-tip';
    tipDate.className = 'prj-tip-date';
    tip.hidden = true;
    tip.appendChild(tipDate);
    tip.appendChild(tipText);
    document.body.appendChild(tip);
    var activeCell = null;

    function hide() {
      if (activeCell) activeCell.classList.remove('is-active');
      activeCell = null;
      tip.hidden = true;
    }

    function show(cell) {
      if (activeCell) activeCell.classList.remove('is-active');
      activeCell = cell;
      cell.classList.add('is-active');
      tipDate.textContent = cell.getAttribute('data-date');
      // No line break inside "2-D" or "6.01 ms": non-breaking hyphens and spaces.
      tipText.textContent = cell
        .getAttribute('data-topic')
        .replace(/(\w)-(?=\w)/g, '$1‑')
        .replace(/(\d) (?=(ms|µs|cm|mm|m|MHz|kHz|Hz|Vpp|V|kΩ|%|→)(?![A-Za-z]))/g, '$1 ')
        .replace(/ → /g, ' → ');
      tip.hidden = false;
      var r = cell.getBoundingClientRect();
      var w = tip.offsetWidth;
      var h = tip.offsetHeight;
      var x = Math.min(Math.max(8, r.left + r.width / 2 - w / 2), window.innerWidth - w - 8);
      var y = r.top - h - 8;
      if (y < 8) y = r.bottom + 8;
      tip.style.left = x + 'px';
      tip.style.top = y + 'px';
    }

    Array.prototype.forEach.call(root.querySelectorAll('svg'), function (svg) {
      var cells = Array.prototype.slice.call(svg.querySelectorAll('.prj-cell'));
      function nearest(e) {
        var best = null;
        var bestD = 24 * 24;
        for (var i = 0; i < cells.length; i++) {
          var r = cells[i].getBoundingClientRect();
          var dx = e.clientX - (r.left + r.width / 2);
          var dy = e.clientY - (r.top + r.height / 2);
          var d = dx * dx + dy * dy;
          if (d < bestD) {
            bestD = d;
            best = cells[i];
          }
        }
        if (!best) hide();
        else if (best !== activeCell) show(best);
      }
      svg.addEventListener('pointermove', nearest);
      svg.addEventListener('pointerdown', nearest);
      svg.addEventListener('pointerleave', function (e) {
        if (e.pointerType === 'mouse') hide();
      });
      svg.addEventListener('blur', hide);
      svg.addEventListener('keydown', function (e) {
        if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
          e.preventDefault();
          var i = cells.indexOf(activeCell);
          i = i < 0 ? 0 : i + (e.key === 'ArrowRight' ? 1 : -1);
          show(cells[Math.max(0, Math.min(cells.length - 1, i))]);
        } else if (e.key === 'Escape') {
          hide();
        }
      });
    });
    window.addEventListener('scroll', hide, { passive: true });
  })();
</script>
