{%- comment -%}
  Line breaks that the theme's own templates (publication entries, news) cannot be told about:
  hyphenated words such as SKiD-SLAM, KISS-IMU or 10-2928592 stay whole, and a news date
  ("Oct 01, 2026") stays on one line. Included at the end of _pages/about.md, ko.md and
  publications.md; it runs once the page is parsed, so it also reaches the news and the
  selected papers that the layout adds after the page content.
{%- endcomment -%}
<script>
  (function () {
    if (window.__glueWords) return;
    window.__glueWords = true;
    function run() {
      var root = document.querySelector('.post') || document.body;
      var has = /[A-Za-z0-9]-[A-Za-z0-9]/;
      var word = /[A-Za-z0-9][A-Za-z0-9.+\/]*(?:-[A-Za-z0-9.+\/]*[A-Za-z0-9])+/g;
      var nodes = [];
      var walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
      for (var n = walker.nextNode(); n; n = walker.nextNode()) {
        var p = n.parentElement;
        if (!p || p.closest('script, style, pre, code, textarea, svg, .nobr')) continue;
        if (has.test(n.nodeValue)) nodes.push(n);
      }
      nodes.forEach(function (n) {
        var text = n.nodeValue;
        var frag = document.createDocumentFragment();
        var last = 0;
        var m;
        word.lastIndex = 0;
        while ((m = word.exec(text))) {
          if (m.index > last) frag.appendChild(document.createTextNode(text.slice(last, m.index)));
          var s = document.createElement('span');
          s.className = 'nobr';
          s.textContent = m[0];
          frag.appendChild(s);
          last = m.index + m[0].length;
        }
        if (last < text.length) frag.appendChild(document.createTextNode(text.slice(last)));
        n.parentNode.replaceChild(frag, n);
      });
      Array.prototype.forEach.call(root.querySelectorAll('.news th'), function (th) {
        if (th.children.length === 0) th.textContent = th.textContent.trim().replace(/\s+/g, '\u00a0');
      });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run);
    else run();
  })();
</script>
