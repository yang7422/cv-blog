{%- comment -%}
  Links to the other project pages, at the end of each one, in the order of /projects/.
{%- endcomment -%}
{%- assign prj_all = site.projects | sort: 'importance' -%}
<nav class="prj-more" aria-label="More projects">
  <p class="prj-more-title">More projects</p>
  <ul>
    {%- for p in prj_all -%}
      {%- unless p.url == page.url -%}
        <li>
          <a href="{{ p.url | relative_url }}">{{ p.title }}</a>
        </li>
      {%- endunless -%}
    {%- endfor -%}
    <li><a href="{{ '/projects/' | relative_url }}">All projects</a></li>
  </ul>
</nav>
